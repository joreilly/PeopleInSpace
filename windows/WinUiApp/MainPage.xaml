<Page
    x:Class="PeopleInSpace.Windows.WinUiApp.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PeopleInSpace.Windows.WinUiApp"
    xmlns:shared="using:PeopleInSpace.Windows.Shared"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Page.Resources>
        <local:ImageUrlConverter x:Key="ImageUrlConverter" />
    </Page.Resources>
    <NavigationView x:Name="RootNavigation" PaneDisplayMode="Top" IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False" ItemInvoked="OnNavigationItemInvoked">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="PeopleNavigationItem" Content="People" Icon="Contact" Tag="people" IsSelected="True" />
            <NavigationViewItem x:Name="IssNavigationItem" Content="ISS" Icon="World" Tag="iss" />
        </NavigationView.MenuItems>

        <Grid Padding="32">
            <Grid x:Name="PeopleSection" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="People in Space" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="Current crew assignments" Opacity="0.72" />
                    </StackPanel>
                    <Button Grid.Column="1" Command="{x:Bind ViewModel.RefreshCommand}" Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Refresh" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                </Grid>
                <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.HasPeopleError, Mode=OneWay}"
                         Severity="Error" Title="Couldn’t refresh people" Message="{x:Bind ViewModel.PeopleError, Mode=OneWay}"
                         IsClosable="False">
                    <InfoBar.ActionButton>
                        <Button Content="Retry" Command="{x:Bind ViewModel.RefreshCommand}" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <Grid Grid.Row="2" ColumnSpacing="24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                    <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid>
                            <ListView ItemsSource="{x:Bind ViewModel.People, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedPerson, Mode=TwoWay}" SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="shared:PersonViewModel">
                                        <Grid Padding="4,10" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <PersonPicture Width="48" Height="48" ProfilePicture="{Binding ImageUrl, Converter={StaticResource ImageUrlConverter}}" />
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind Craft}" Opacity="0.70" />
                                            </StackPanel>
                                            <SymbolIcon Grid.Column="2" Symbol="ChevronRight" VerticalAlignment="Center" Opacity="0.55" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <ProgressRing IsActive="{x:Bind ViewModel.PeopleLoading, Mode=OneWay}" Width="32" Height="32"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <ProgressRing IsActive="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}" Width="20" Height="20"
                                          HorizontalAlignment="Right" VerticalAlignment="Top" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Padding="24" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <ScrollViewer>
                            <StackPanel Spacing="10">
                                <TextBlock Text="CREW MEMBER" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="{Binding SelectedPerson.Name}" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedPerson.Craft}" Opacity="0.72" />
                                <TextBlock Text="Nationality" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
                                <TextBlock Text="{Binding SelectedPerson.Nationality}" TextWrapping="Wrap" />
                                <TextBlock Text="Biography" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
                                <TextBlock Text="{Binding SelectedPerson.Biography}" TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="IssSection" Visibility="Collapsed" RowSpacing="16">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="International Space Station" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Live orbital position" Opacity="0.72" />
                </StackPanel>
                <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.HasIssError, Mode=OneWay}" Severity="Error"
                         Title="Couldn’t update the ISS position" Message="{x:Bind ViewModel.IssError, Mode=OneWay}" IsClosable="False" />
                <Border Grid.Row="2" Padding="32" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="16">
                        <FontIcon Glyph="&#xE709;" FontSize="48" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="Coordinates" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.IssLocation, Mode=OneWay}" Style="{StaticResource DisplayTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.IssTimestamp, Mode=OneWay}" Opacity="0.72" />
                        <ProgressRing IsActive="{x:Bind ViewModel.IssLoading, Mode=OneWay}" Width="28" Height="28" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </NavigationView>
</Page>
