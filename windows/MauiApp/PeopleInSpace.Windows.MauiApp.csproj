<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.19041.0</TargetFrameworks>
    <RootNamespace>PeopleInSpace.Windows.MauiApp</RootNamespace>
    <AssemblyName>PeopleInSpace.Windows.MauiApp</AssemblyName>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <WindowsPackageType>None</WindowsPackageType>
    <ApplicationTitle>People in Space</ApplicationTitle>
    <ApplicationId>dev.johnoreilly.peopleinspace.maui</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">maccatalyst-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">win-x64</RuntimeIdentifier>
    <PlatformTarget Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#155E75" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#155E75" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\PeopleInSpace.Windows.Shared.csproj" />
    <!-- Shared compiles Interop.cs. This host carries native runtime assets only. -->
    <PackageReference Include="PeopleInSpace.Kotlin" Version="0.1.0" GeneratePathProperty="true"
                      IncludeAssets="runtime;native" ExcludeAssets="compile;contentFiles;build;buildTransitive;analyzers" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
  </ItemGroup>

  <!-- The Kotlin package exposes macosArm64 as osx-arm64; Catalyst needs this explicit link. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <NativeReference Include="$(PkgPeopleInSpace_Kotlin)\runtimes\osx-arm64\native\libpeopleinspace.dylib"
                     Kind="Dynamic" SmartLink="False" />
    <TrimmerRootAssembly Include="PeopleInSpace.Windows.Shared" />
  </ItemGroup>
</Project>
