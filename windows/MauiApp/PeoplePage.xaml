<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="PeopleInSpace.Windows.MauiApp.PeoplePage"
             x:Name="RootPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="{StaticResource PageBackground}">
    <Grid Padding="22" RowDefinitions="Auto,Auto,*" RowSpacing="14">
        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="3">
                <Label Text="People in Space" FontSize="28" FontAttributes="Bold" />
                <Label Text="Current crew assignments" TextColor="{StaticResource SecondaryText}" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Refresh" Command="{Binding RefreshCommand}" />
        </Grid>

        <Border Grid.Row="1" IsVisible="{Binding HasPeopleError}" BackgroundColor="#FDECEC" Stroke="#D64545" Padding="12" StrokeShape="RoundRectangle 8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label Text="{Binding PeopleError}" TextColor="#8B1E1E" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Retry" Command="{Binding RefreshCommand}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="1.2*,*" ColumnSpacing="16">
            <Border BackgroundColor="{StaticResource CardBackground}" Stroke="#D9E2EC" Padding="8" StrokeShape="RoundRectangle 10">
                <Grid>
                    <CollectionView ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson, Mode=TwoWay}" SelectionMode="Single">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8" ColumnDefinitions="58,*,Auto" ColumnSpacing="10">
                                    <Image WidthRequest="48" HeightRequest="48" Aspect="AspectFill" Source="{Binding ImageUrl}" />
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                                        <Label Text="{Binding Craft}" TextColor="{StaticResource SecondaryText}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="›" FontSize="26" VerticalOptions="Center" TextColor="{StaticResource SecondaryText}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <ActivityIndicator IsRunning="{Binding PeopleLoading}" IsVisible="{Binding PeopleLoading}"
                                       Color="{StaticResource BrandColor}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border Grid.Column="1" BackgroundColor="{StaticResource CardBackground}" Stroke="#D9E2EC" Padding="22" StrokeShape="RoundRectangle 10">
                <Grid>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding SelectedPerson, Converter={StaticResource NullToBoolConverter}, ConverterParameter=Invert}">
                        <Label Text="Select a crew member" TextColor="{StaticResource SecondaryText}" />
                    </VerticalStackLayout>
                    <ScrollView BindingContext="{Binding Source={x:Reference RootPage}, Path=BindingContext.SelectedPerson}"
                                IsVisible="{Binding Source={x:Reference RootPage}, Path=BindingContext.SelectedPerson, Converter={StaticResource NullToBoolConverter}}">
                        <VerticalStackLayout Spacing="10">
                            <Image HeightRequest="180" Aspect="AspectFit" Source="{Binding ImageUrl}" />
                            <Label Text="{Binding Name}" FontSize="25" FontAttributes="Bold" />
                            <Label Text="{Binding Craft}" TextColor="{StaticResource BrandColor}" FontAttributes="Bold" />
                            <Label Text="Nationality" FontAttributes="Bold" Margin="0,10,0,0" />
                            <Label Text="{Binding Nationality}" />
                            <Label Text="Biography" FontAttributes="Bold" Margin="0,10,0,0" />
                            <Label Text="{Binding Biography}" />
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
