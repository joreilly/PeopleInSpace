<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <AssemblyName>PeopleInSpace.Windows.Shared</AssemblyName>
    <RootNamespace>PeopleInSpace.Windows.Shared</RootNamespace>
    <RuntimeIdentifier Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">win-x64</RuntimeIdentifier>
    <PlatformTarget Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- The package's contentFiles have buildAction=Compile. Shared is their sole compiler. -->
    <PackageReference Include="PeopleInSpace.Kotlin" Version="0.1.0" />
  </ItemGroup>
</Project>
