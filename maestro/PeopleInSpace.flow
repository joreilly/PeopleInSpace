# Shared by the Android and iOS apps: CI passes APP_ID with -e
appId: ${APP_ID}
---
- launchApp:
    clearState: true

- assertVisible: "People in Space"

- tapOn: "ISS Position"
# Allow for slow CI emulators (the default assertVisible wait occasionally times out)
- extendedWaitUntil:
    visible: "ISS Position"
    timeout: 30000

- tapOn: "People"
- assertVisible: "People in Space"
# The people list comes from a live API
- extendedWaitUntil:
    visible:
      id: "person0"
    timeout: 30000

- takeScreenshot: PeopleInSpace
